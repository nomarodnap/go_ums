PORT=8080
DATABASE_URL="postgresql://user:password@localhost:6432/ums?sslmode=disable"
DIRECT_URL="postgresql://user:password@localhost:5432/ums?sslmode=disable"
JWT_SECRET="your-jwt-secret-key"
CORS_ORIGIN="http://localhost:3000"
APP_URL="http://localhost:3000"

# SMTP Configuration (Brevo)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-pass"
SMTP_FROM_NAME="ระบบรายงานค่าสาธารณูปโภค กรมประมง"
SMTP_FROM_EMAIL="noreply@fisheries.go.th"

# Garage Object Storage (S3-compatible)
GARAGE_ENDPOINT="http://localhost:3900"
GARAGE_ACCESS_KEY="ums-access-key"
GARAGE_SECRET_KEY="ums-secret-key"
GARAGE_REGION="garage"
GARAGE_USE_SSL="false"
GARAGE_BUCKET="ums-uploads"

# AI Assistant (Google Gemini)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"

# LINE Messaging API (for Department LINE Notifications & AI Chatbot via LINE OA)
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN="your-line-messaging-api-channel-access-token"
LINE_MESSAGING_CHANNEL_SECRET="your-line-messaging-api-channel-secret"
